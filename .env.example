# =====================================================================
# FILE: .env.example           (REPO ROOT - this one IS committed to Git)
# =====================================================================
# HOW TO USE
#   1. Copy it:        cp .env.example .env
#   2. Edit .env and CHANGE every password.
#   3. Run:            docker compose up -d --build
#
# .env holds the settings that change per computer / per hospital / per
# server. Docker Compose reads it automatically and fills the ${...}
# holes in docker-compose.yml.
#
# .env is listed in .gitignore and .dockerignore, so it is never committed
# and never copied into an image. NEVER commit a real .env.
#
# PASSWORD RULES: use letters, digits and _ - ! only. The characters
# ;  =  $  would break the database connection string.
# SQL Server needs: 8+ characters with upper case, lower case and a digit.
# =====================================================================

# ---- Database (SQL Server container) --------------------------------
MSSQL_SA_PASSWORD=Change_Me_Db_Pass_123!
DB_NAME=HospitalDB

# ---- The web app (becomes ASP.NET settings: Hospital__Name = Hospital:Name)
HOSPITAL_NAME=Hospital A
MIGRATE_ON_STARTUP=true
SECURE_COOKIES=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Change_Me_Admin_123!
SEED_SAMPLE_DATA=true

# ---- Docker details -------------------------------------------------
# The port on YOUR computer. The app inside always uses 8080.
WEB_PORT=8080
# The image name and version. For Docker Hub use:  yourname/hospital-web
IMAGE_NAME=hospital-web
IMAGE_TAG=dev

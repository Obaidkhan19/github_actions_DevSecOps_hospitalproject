@model AppointmentEditViewModel
@{
    ViewData["Title"] = "Edit appointment";
}

<h1 class="h3 mb-3">Edit appointment #@Model.Id</h1>
<p class="text-muted">Patient: @Model.PatientName</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PatientName" />
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="DoctorId" class="form-label"></label>
            <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select"></select>
            <span asp-validation-for="DoctorId" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Reason" class="form-label"></label>
            <input asp-for="Reason" class="form-control" />
            <span asp-validation-for="Reason" class="text-danger small"></span>
        </div>
    </div>
    <p class="form-text mt-2">Changing the doctor sends the patient a "rescheduled" email.</p>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

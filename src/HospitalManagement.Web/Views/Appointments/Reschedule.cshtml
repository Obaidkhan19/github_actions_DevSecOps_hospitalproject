@model RescheduleViewModel
@{
    ViewData["Title"] = "Reschedule appointment";
}

<h1 class="h3 mb-3">Reschedule appointment #@Model.Id</h1>
<p class="text-muted">@Model.PatientName with @Model.DoctorName</p>

<form asp-action="Reschedule" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PatientName" />
    <input type="hidden" asp-for="DoctorName" />
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" />
            <span asp-validation-for="Date" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Time" class="form-label"></label>
            <input asp-for="Time" class="form-control" step="1800" />
            <span asp-validation-for="Time" class="text-danger small"></span>
        </div>
    </div>
    <p class="form-text mt-2">The patient receives a "rescheduled" email.</p>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Reschedule</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

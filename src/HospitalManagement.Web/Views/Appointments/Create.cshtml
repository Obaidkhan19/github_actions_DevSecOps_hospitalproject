@model AppointmentFormViewModel
@{
    ViewData["Title"] = "New appointment";
}

<h1 class="h3 mb-3">New appointment</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="PatientId" class="form-label"></label>
            <select asp-for="PatientId" asp-items="Model.Patients" class="form-select">
                <option value="0">Select a patient...</option>
            </select>
            <span asp-validation-for="PatientId" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DoctorId" class="form-label"></label>
            <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select">
                <option value="0">Select a doctor...</option>
            </select>
            <span asp-validation-for="DoctorId" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" />
            <span asp-validation-for="Date" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Time" class="form-label"></label>
            <input asp-for="Time" class="form-control" step="1800" />
            <span asp-validation-for="Time" class="text-danger small"></span>
        </div>
        <div class="col-12">
            <label asp-for="Reason" class="form-label"></label>
            <input asp-for="Reason" class="form-control" />
            <span asp-validation-for="Reason" class="text-danger small"></span>
        </div>
    </div>
    <p class="form-text mt-2">Appointments last 30 minutes and are available from 08:00 to 17:30. The patient receives a confirmation email.</p>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Schedule</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@model Appointment
@{
    ViewData["Title"] = "Appointment";
    var isScheduled = Model.Status == AppointmentStatus.Scheduled;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Appointment #@Model.Id</h1>
    <a asp-action="Index" class="btn btn-link">Back to appointments</a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Patient</dt>
            <dd class="col-sm-9"><a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId">@(Model.Patient!.FullName)</a></dd>
            <dt class="col-sm-3">Doctor</dt><dd class="col-sm-9">@(Model.Doctor!.DisplayName) (@(Model.Doctor.Specialization))</dd>
            <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.AppointmentDate.ToString("yyyy-MM-dd")</dd>
            <dt class="col-sm-3">Time</dt><dd class="col-sm-9">@Model.AppointmentTime.ToString("HH:mm")</dd>
            <dt class="col-sm-3">Reason</dt><dd class="col-sm-9">@Model.Reason</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</dd>
        </dl>
    </div>
</div>

@if (isScheduled)
{
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        <a asp-action="Reschedule" asp-route-id="@Model.Id" class="btn btn-outline-primary">Reschedule</a>
        <form asp-action="Complete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Mark as completed</button>
        </form>
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel this appointment? The patient will be notified by email.');">
            <button type="submit" class="btn btn-outline-danger">Cancel appointment</button>
        </form>
    </div>
}
